generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  firstname  String
  lastname   String
  title      String    @default("Dr.")
  staffId    String    @unique
  email      String    @unique
  password   String
  createdAt  DateTime  @default(now())
  role       Role
  department String?
  faculty    String?
  rank       String?
  bio        String?
  phoneNo    String?
  dateJoined DateTime?
  avatar     String?
}

enum Role {
  PUBLISHER
  ACCESSOR
  HRMD
  VC
}

