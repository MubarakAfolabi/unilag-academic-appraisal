// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  firstname    String
  lastname     String
  title        String        @default("Dr.")
  staffId      String        @unique
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  role         Role
  department   String?
  faculty      String?
  rank         String?
  bio          String?
  phoneNo      String?
  dateJoined   DateTime?
  avatar       String?
  publications Publication[]

  reviews Review[]
}

enum Role {
  PUBLISHER
  ACCESSOR
  HRMD
  VC
}

model Publication {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fullCitation    String
  publicationType PublicationType
  quartileRanking QuartileRanking
  nonIndexed      NonIndexed?
  classification  Classification

  originalName String?
  filePath     String?
  fileName     String?
  fileSize     Int?
  mimeType     String?

  status PublicationStatus @default(PENDING)
  userId Int
  user   User              @relation(fields: [userId], references: [id])

  reviews Review[]
}

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE
  BOOK
  BOOK_CHAPTER
}

enum QuartileRanking {
  Q1
  Q2
  Q3
  OTHERS
}

enum NonIndexed {
  UNIVERSITY_BASED
  NON_UNIVERSITY_BASED
}

enum Classification {
  NATIONAL
  INTERNATIONAL
}

enum PublicationStatus {
  PENDING
  UNDER_REVIEW
  SCORED
}

model Review {
  id Int @id @default(autoincrement())

  status      ReviewStatus @default(PENDING)
  assignedAt  DateTime     @default(now())
  openedAt    DateTime?
  completedAt DateTime?

  reviewerId Int
  reviewer   User @relation(fields: [reviewerId], references: [id])

  publicationId Int
  publication   Publication @relation(fields: [publicationId], references: [id])

  @@unique([reviewerId, publicationId])
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
